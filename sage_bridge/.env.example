# Supabase project (same values as the Streamlit app secrets)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Which Sage company to post into — a substring that matches the company
# name, database name, or path as shown by probe.ps1's company list
# e.g. Ratech   or   RATECHMFG
SAGE_COMPANY_NAME=YOUR-COMPANY-NAME

# REQUIRED: the application identifier issued by Sage / your Sage partner.
# A ~300-char string. Blank only works on Sage sample companies.
SAGE_APP_ID=PASTE-ISSUED-APP-ID-HERE

# Optional: where Sage is installed (default is the standard x86 path)
#SAGE_BASE_DIR=C:\Program Files (x86)\Sage

# How often to check the queue (seconds)
POLL_SECONDS=60
