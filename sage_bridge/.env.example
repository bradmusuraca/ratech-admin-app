# Supabase project (same values as the Streamlit app secrets)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Path to the Sage 50 company folder (as Sage's Open Company dialog sees it)
# e.g. C:\Sage\Peachtree\Company  or  \\SERVER\Sage\CompanyName
SAGE_COMPANY_PATH=C:\path\to\your\company

# How often to check the queue (seconds)
POLL_SECONDS=60
