# Google Cloud Vision API Credentials
# Paste your service account JSON here (as a single line or use path to JSON file)
GOOGLE_CREDENTIALS=your_google_cloud_credentials_json_here

# Alternatively, set the path to your credentials file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json

# Application Settings
APP_NAME=Ratech Order Management
APP_VERSION=1.0.0

# Gemini AI (optional - improves parsing for new vendors)
GEMINI_API_KEY=your_gemini_api_key_here

# Email inbox (IMAP). Reads are non-destructive; an email is marked read
# only after it is loaded into the queue or explicitly ignored.
# Yahoo requires an APP PASSWORD, not your regular password:
# Yahoo Account Security -> Generate app password
EMAIL_HOST=imap.mail.yahoo.com
EMAIL_PORT=993
EMAIL_USER=order_processing@ratech-mfg.com
EMAIL_PASSWORD=your_yahoo_app_password_here

# Optional SMTP overrides for sending confirmation emails (defaults: Yahoo)
EMAIL_SMTP_HOST=smtp.mail.yahoo.com
EMAIL_SMTP_PORT=465

# Go-live cutoff - only emails received on/after this date are shown
# (IMAP format: DD-Mon-YYYY). Older unread mail is left alone.
EMAIL_START_DATE=12-Oct-2026

# Optional default recipient for inventory discrepancy emails
DISCREPANCY_EMAIL_TO=

# Sage 50 Sales Order Journal (SO.CSV) required defaults
SAGE_AR_ACCOUNT=your_ar_gl_account
SAGE_GL_ACCOUNT=your_sales_gl_account
SAGE_TAX_ID=your_sales_tax_code
SAGE_TAX_TYPE=1
SAGE_TERMS=Net Due

# Marketplace clearing account - ShipStation (eBay/Amazon) rows export under
# this Sage customer ID even if the customers table doesn't resolve one
SAGE_MARKETPLACE_CUSTOMER=100B

# Customer mapping (preferred over a committed customers.csv - keeps customer
# data out of a public repo). Full CSV text as one value:
# CUSTOMERS_CSV="Customer Number,Customer Name,Aliases,Their Code For Us
# 100B,eBay Orders,ebay,
# ..."

# Optional baseline email triage rules (same layout):
# EMAIL_RULES_CSV="Sender,Classification
# newsletter@vendor.com,ignore"

# ShipStation API - generate in ShipStation: Settings -> Account -> API Settings
# (requires Standard plan or higher)
SHIPSTATION_API_KEY=your_api_key_here
SHIPSTATION_API_SECRET=your_api_secret_here

# Supabase queue for automatic Sage 50 posting (see sage_bridge/README.md).
# Same two values go on BOTH the app and the desktop bridge:
# SUPABASE_URL = project URL; SUPABASE_KEY = service-role key (secret).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Optional user logins (JSON). If unset, the app is open to anyone.
# "pages" limits which nav tabs the user can see.
# Use "password" (plaintext) or "password_hash" (sha256 hex).
# USERS_JSON={"admin":{"password":"changeme","name":"Brad","pages":["Order Processing","Customers","Inventory Management","Settings"]},"floor":{"password":"floor123","name":"Warehouse","pages":["Inventory Management"]}}
